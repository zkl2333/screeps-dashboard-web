{
  "name": "screeps-dashboard",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "cd src-next && next build",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "cd src-next && eslint .",
    "typecheck": "tsc --noEmit --incremental false -p src-next/tsconfig.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "assets:resource-icons": "node scripts/fetch-resource-thumbnails.mjs"
  },
  "dependencies": {
    "@screeps/renderer": "^1.6.8-arena",
    "@screeps/renderer-metadata": "^1.6.8-arena",
    "next": "^15.3.0",
    "pixijs": "^7.1.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "swr": "^2.3.0",
    "ws": "8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "25.2.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
